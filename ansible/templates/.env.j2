# Application Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY={{ lookup('password', '/dev/null chars=ascii_letters,digits length=32') }}
DEBUG=False
PORT=8000

# Database Configuration - MongoDB
{% if groups['role_master'] is defined and groups['role_master'] | length > 0 %}
# MongoDB Connection Settings
MONGODB_HOST={{ hostvars[groups['role_master'][0]].private_ip_address }}
MONGODB_PORT=27017
MONGODB_USERNAME={{ db_username }}
MONGODB_PASSWORD={{ db_password }}
MONGODB_DATABASE={{ db_name }}
MONGODB_REPLICA_SET=rs0
MONGODB_AUTH_SOURCE=admin

# Connection String Formats
# Standard connection string
MONGODB_URI=mongodb://{{ db_username }}:{{ db_password }}@{{ hostvars[groups['role_master'][0]].private_ip_address }}:27017/{{ db_name }}?authSource=admin

# Replica set connection string (if using replica set)
MONGODB_URI_REPLICA=mongodb://{{ db_username }}:{{ db_password }}@{% for host in groups['all'] %}{{ hostvars[host].private_ip_address }}:27017{% if not loop.last %},{% endif %}{% endfor %}/{{ db_name }}?replicaSet=rs0&authSource=admin

# For PyMongo/MongoEngine
DATABASE_URL=mongodb://{{ db_username }}:{{ db_password }}@{{ hostvars[groups['role_master'][0]].private_ip_address }}:27017/{{ db_name }}?authSource=admin

# Optional MongoDB Settings
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=300000
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=30000
{% endif %}

# Application Settings
LOG_LEVEL=INFO

# Additional Settings
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata

# MongoDB Driver Settings (if using specific ODM)
# For MongoEngine (if you're using it)
# MONGODB_SETTINGS={'db': '{{ db_name }}', 'host': '{{ hostvars[groups['role_master'][0]].private_ip_address }}', 'port': 27017, 'username': '{{ db_username }}', 'password': '{{ db_password }}', 'authentication_source': 'admin'}

# For Flask-PyMongo
# MONGO_URI=mongodb://{{ db_username }}:{{ db_password }}@{{ hostvars[groups['role_master'][0]].private_ip_address }}:27017/{{ db_name }}?authSource=admin